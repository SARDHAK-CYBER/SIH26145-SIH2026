OPENSEARCH_ADMIN_PASSWORD=change_me_to_a_real_password
POSTGRES_PASSWORD=change_me_to_a_real_password
# Required: shared API key for the API, dashboard sign-in and sensor (>=16 random chars). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
STEALTHTAP_API_KEY=
# Bind address for the API/dashboard ports. Leave 127.0.0.1 unless a TLS reverse proxy fronts them.
# STEALTHTAP_BIND=127.0.0.1
# Signs login tokens (>=32 chars). python -c "import secrets;print(secrets.token_urlsafe(48))"
STEALTHTAP_TOKEN_SECRET=
# Optional multi-tenant / role keys: tenant[/role]=key  (roles: viewer analyst sensor admin)
# STEALTHTAP_TENANT_KEYS=acme=<key>,globex/viewer=<key>,plant7/sensor=<key>
