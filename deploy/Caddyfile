# TLS front for the dashboard (:443) and the API (:8443). Everything behind it stays on loopback / the compose network.
#   STEALTHTAP_HOST  name clients use (default localhost). A public DNS name gets a real certificate automatically.
#   STEALTHTAP_TLS   "internal" (default): Caddy's own local CA -- browsers warn until you trust it (see docs/OPERATIONS.md)
#                    or an e-mail address: obtain a public Let's Encrypt certificate (needs ports 80/443 reachable from the internet)
(secure) {
	tls {$STEALTHTAP_TLS:internal}
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}

{$STEALTHTAP_HOST:localhost} {
	import secure
	reverse_proxy dashboard:4173
}

{$STEALTHTAP_HOST:localhost}:8443 {
	import secure
	request_body {
		max_size 1GB      # pcap uploads
	}
	# flush_interval -1: Server-Sent-Events (live alert stream) must not be buffered
	# STEALTHTAP_API_UPSTREAMS: "api:8000" (default) or "api:8000 api2:8000" (profile ha). Client-IP affinity keeps an async analysis job
	# and its uploaded capture on the replica that holds them; a dead replica is taken out after its next failed health check.
	reverse_proxy {$STEALTHTAP_API_UPSTREAMS:api:8000} {
		lb_policy client_ip_hash
		health_uri /health
		health_interval 3s
		health_timeout 2s
		fail_duration 15s
		lb_try_duration 5s
		flush_interval -1
		transport http {
			response_header_timeout 15m
		}
	}
}
